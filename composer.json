{
    "name": "security/zero-trust-php-app",
    "description": "Enterprise-Grade Zero-Trust PHP Authentication & Continuous Adaptive Trust Engine with AEAD Cryptography, Proof-of-Work Anti-AI Bot Defense, RFC 6238 TOTP MFA, and Hash-Chained Audit Ledger.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "ext-openssl": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "ZeroTrust\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZeroTrust\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/SecurityTest.php",
        "phpunit": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "verify-ledger": "php bin/verify-ledger.php",
        "serve": "php -S 127.0.0.1:8080 -t public"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
