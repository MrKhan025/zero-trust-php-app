{
    "name": "mrkhan025/zerotrust-php",
    "description": "Zero-Trust PHP Authentication & Continuous Adaptive Trust Engine with AEAD Cryptography, Proof-of-Work Anti-AI Bot Defense, RFC 6238 TOTP & WebAuthn Passkeys, and Hash-Chained Audit Ledger.",
    "type": "project",
    "homepage": "https://github.com/MrKhan025/zerotrust-php",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/MrKhan025/zerotrust-php/issues",
        "source": "https://github.com/MrKhan025/zerotrust-php",
        "security": "https://github.com/MrKhan025/zerotrust-php/blob/main/SECURITY.md",
        "docs": "https://github.com/MrKhan025/zerotrust-php#readme"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "ext-openssl": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "ZeroTrust\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZeroTrust\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/SecurityTest.php",
        "phpunit": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "verify-ledger": "php bin/verify-ledger.php",
        "serve": "php -S 127.0.0.1:8080 -t public"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
