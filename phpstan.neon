parameters:
    level: 6
    paths:
        - src
        - bin
        - public
        - tests
    excludePaths:
        - storage
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Intentional for demo/test environments and optional Redis extension
        - '#Call to an undefined method PDO::setAttribute#'
        - '#unknown class Redis#i'
        - '#Class Redis not found#i'
