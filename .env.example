# ============================================================================
# ZERO-TRUST PHP APPLICATION — SECURITY ENVIRONMENT CONFIGURATION
# ============================================================================
# CRITICAL: Never commit your production .env file to version control.
# Generate fresh 256-bit keys using: php bin/verify-ledger.php --generate-keys

APP_NAME="ZeroTrust Shield Enterprise"
APP_ENV="production"
APP_DEBUG="false"
APP_URL="https://auth.example.com"
APP_TIMEZONE="UTC"

# ----------------------------------------------------------------------------
# CRYPTOGRAPHIC MASTER KEYS (HEX-ENCODED 256-BIT / 64 HEX CHARS)
# ----------------------------------------------------------------------------
# Used for XChaCha20-Poly1305 / AES-256-GCM authenticated encryption at rest
ZT_MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Used for HMAC-SHA256 password peppering before Argon2id hashing
ZT_AUTH_PEPPER_SECRET="fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"

# Used for Stateless Proof-of-Work (PoW) & CSRF Token Signing
ZT_TOKEN_SIGNING_KEY="a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90"

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION (SQLite Default or MySQL/PostgreSQL DSN)
# ----------------------------------------------------------------------------
DB_CONNECTION="sqlite"
DB_SQLITE_PATH="storage/database/zerotrust.sqlite"
# DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=zerotrust;charset=utf8mb4"
# DB_USERNAME="zerotrust_user"
# DB_PASSWORD="change_me_in_production"

# ----------------------------------------------------------------------------
# ZERO-TRUST POLICY & ADAPTIVE RISK THRESHOLDS
# ----------------------------------------------------------------------------
# Maximum allowed risk score (0-100) before denying access (Step-Up MFA at 40+)
ZT_RISK_STEP_UP_THRESHOLD=40
ZT_RISK_TERMINATE_THRESHOLD=75

# Session TTL & Rotation (in seconds)
ZT_SESSION_IDLE_TIMEOUT=900
ZT_SESSION_ABSOLUTE_LIFETIME=14400
ZT_SESSION_ROTATION_INTERVAL=300

# ----------------------------------------------------------------------------
# ANTI-AI / BOT DEFENSE & PROOF-OF-WORK (PoW)
# ----------------------------------------------------------------------------
# Number of leading hex zeroes required in SHA-256 PoW challenge (default: 4 = ~65,536 hashes)
ZT_POW_DIFFICULTY=4
ZT_POW_TTL_SECONDS=180

# Rate Limiting (Sliding Window)
ZT_RATE_LIMIT_MAX_ATTEMPTS=5
ZT_RATE_LIMIT_WINDOW_SECONDS=300
ZT_RATE_LIMIT_LOCKOUT_SECONDS=900
